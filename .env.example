# Spring 서버 주소는 그대로 localhost:8080입니다.
# 개발 확인은 localhost:5173, 8080 통합 확인은 dist를 Spring static에 배치합니다.
API_PROXY_TARGET=http://localhost:8080
# 첨부 서버 규격이 기본값입니다. /api/csrf를 요청하지 않습니다.
VITE_API_MODE=server-dev
VITE_API_BASE_URL=
# 카테고리 이름과 실제 서버 DB ID를 연결합니다. 임의의 ID를 넣지 마세요.
VITE_SERVER_CATEGORY_IDS={}
# 기존 쿠키/CSRF 방식 서버를 명시적으로 사용하는 경우에만 original을 지정하세요.
